RABBITMQ_URL=amqp://guest:guest@localhost:5672
NODE_INTERNAL_URL=http://localhost:4000
INTERNAL_API_SECRET=dev-secret
# PHẢI trỏ cùng Redis mà server Node dùng (env.redisUrl).
REDIS_URL=redis://localhost:6379
# Giây — mặc định 1 ngày. Không cần khớp số với Node (Node không dùng hằng số này).
CACHE_TTL_WARM_SECONDS=86400
